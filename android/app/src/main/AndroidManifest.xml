<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- This manifest declares no sensitive runtime permissions: no
         microphone, no calendar, no location. Those live in
         src/sensitive/manifest-fragment.xml and are merged in only by a build
         that asks for them with -PsnSensitive=true.

         It does declare one notification-listener service. Android will not
         expose another app's active media session to an ordinary app, so the
         "what is playing" strip needs a NotificationListenerService. The
         service is exported=false and protected by
         BIND_NOTIFICATION_LISTENER_SERVICE; the user still has to grant
         Notification access in Settings, and without that grant it is inert.

         Google Play Protect may warn about notification access. That warning
         is honest: the service can technically receive notifications. This app
         uses the callback only to notice that a media session may have changed;
         it does not display notification content. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.KEEP_SCREEN_ON"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- Background audio. A foreground service is not optional on Android 8+:
         a background app cannot keep audio going, and there is no
         notification-only alternative. FOREGROUND_SERVICE_MEDIA_PLAYBACK is the
         Android 14+ permission that covers the mediaPlayback service type; the
         app crashes at runtime without it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- API 33+: without this the media notification is silently dropped and
         there are no lock-screen controls. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Let the assistant give a short haptic tick when it starts listening, so a
         wall display says something even when nobody is looking at it. -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Touchscreen, but not required to be a phone: Nest Hubs, Raspberry Pi
         panels, HDMI sticks and repurposed tablets all qualify. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- Android 11+ package visibility. Without these declarations
         queryIntentActivities() only returns this app's own activities, which
         made the app drawer look empty on a modern tablet. This exposes the
         launcher and leanback-launcher activities only; it is not the
         QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
        </intent>
    </queries>

    <!-- Be explicit that the framework handles Back. Flutter only claims it once
     a Navigator exists and calls setFrameworkHandlesBack(true); opting in keeps
     routing consistent from Android 13 through 16 instead of relying on the
     API-36 default. Note the comment sits outside the tag: XML does not allow
     comments inside a start tag's attribute list. -->
    <!-- Extract the native libraries from the APK.
         Without this, `dlopen("licence_filter")` fails: with the default
         uncompressed packaging the linker can only reach libraries through
         their path inside the APK, not by bare name, so the Rust licence
         filter shipped in every build and could never be opened. The Dart
         implementation was quietly doing all the work.

         The cost is disk: the extracted libraries take a few hundred KB more
         than the compressed ones. -->
    <application
        android:extractNativeLibs="true"
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        android:enableOnBackInvokedCallback="true"
        android:isGame="false">
        <!-- Always declared. MediaSessionManager requires a notification
         listener before it will hand over other apps' sessions; the service
         does nothing until the user grants Notification access in Settings. -->
    <service
        android:name=".MediaSessionListener"
        android:exported="false"
        android:label="@string/app_name"
        android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
        <intent-filter>
            <action android:name="android.service.notification.NotificationListenerService"/>
        </intent-filter>
    </service>

        <!-- The playback service. mediaPlayback is the one foreground service type
         that survives Android 14's new FGS-type requirement and Android 15's
         tightened rules. -->
    <service
        android:name=".PlaybackService"
        android:exported="true"
        android:foregroundServiceType="mediaPlayback">
        <intent-filter>
            <action android:name="androidx.media3.session.MediaSessionService"/>
            <action android:name="android.media.browse.MediaBrowserService"/>
        </intent-filter>
    </service>

    <!-- Hardware and Bluetooth transport buttons. Without this the headset
         buttons do nothing while the app is in the background. -->
    <receiver
        android:name="androidx.media3.session.MediaButtonReceiver"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MEDIA_BUTTON"/>
        </intent-filter>
    </receiver>

    <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:windowSoftInputMode="adjustResize">

            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"/>

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- Lets the launcher be offered as a HOME app on tablets and
                     TV boxes, which is how a Nest Hub replacement should
                     behave on a repurposed device. -->
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>

        <!-- GPU path. Read from the `enableImpeller` Gradle property so a
             build can fall back to the engine's Skia/OpenGL backend on GPU
             stacks whose Vulkan driver misbehaves. See app/build.gradle.kts. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="${enableImpeller}" />

        <!-- Hybrids that render correctly on either backend are far cheaper to
             rasterise. Harmless where unsupported; ignored by Skia. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableWideGamut"
            android:value="false" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required on Android 11+ so url_launcher can see and open other
             apps' deep links (spotify:, https://music.youtube.com, ...). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="spotify" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>
    <!-- SENSITIVE-PERMISSIONS -->
</manifest>
