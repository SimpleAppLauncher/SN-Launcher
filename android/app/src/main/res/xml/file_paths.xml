<?xml version="1.0" encoding="utf-8"?>
<!--
    The one file the updater is allowed to hand to Android's installer.

    The downloaded build lives in the app's own files directory, and Android
    will not take a path: it takes a content:// URI, which this provider
    makes. The path is named exactly, so nothing else in the app's storage
    can be handed out by mistake.
-->
<paths>
    <!--
        The updater hands the downloaded build to Android's installer, and
        the installer takes a content:// URI, not a path. This provider
        makes that URI; the file is update.apk in the app's files directory.

        The root is the files directory, not the file: SimplePathStrategy
        registers a root only if it exists at provider init, and the file
        is downloaded after startup, so a root named for the file drops out
        and install() then fails with "Failed to find configured root".
    -->
    <files-path name="updates" path="." />
</paths>
